#!/usr/bin/env bash
# Updates the agent CLIs you use inside herdr.
# Does NOT talk to the herdr server or start it: it only parses `herdr agent start --help`,
# which is a local read of the argument list.
#
# Usage:  herdr-preflight [--force] [--quiet] [--list]
# Env:
#   HERDR_PREFLIGHT_THROTTLE_HOURS  hours between real runs (default 12, 0 = always)
#   HERDR_PREFLIGHT_TIMEOUT         max seconds per CLI (default 90)
#   HERDR_PREFLIGHT_SKIP            1 to skip everything
set -u

HERDR_BIN="${HERDR_BIN_PATH:-$HOME/.local/bin/herdr}"
CLIS_FILE="$HOME/.config/herdr/preflight-clis"
STATE_DIR="$HOME/.local/state/herdr-preflight"
LOG="$STATE_DIR/update.log"
STAMP="$STATE_DIR/last-run"
LOCK="$STATE_DIR/lock"

THROTTLE_HOURS="${HERDR_PREFLIGHT_THROTTLE_HOURS:-12}"
CLI_TIMEOUT="${HERDR_PREFLIGHT_TIMEOUT:-90}"

FORCE=0; QUIET=0; LIST_ONLY=0
for a in "$@"; do
  case "$a" in
    --force) FORCE=1 ;;
    --quiet) QUIET=1 ;;
    --list)  LIST_ONLY=1 ;;
    -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
  esac
done

mkdir -p "$STATE_DIR"
say() { [ "$QUIET" = 1 ] || printf '%s\n' "$*"; }
log() { printf '[%s] %s\n' "$(date '+%F %T')" "$*" >>"$LOG"; }

[ "${HERDR_PREFLIGHT_SKIP:-0}" = 1 ] && exit 0

# --- which executable belongs to each herdr agent kind ---------------------
exe_for() {
  case "$1" in
    cursor) echo "cursor-agent" ;;
    *)      echo "$1" ;;
  esac
}

# --- how each one updates; rc 1 = no recipe --------------------------------
update_cmd_for() {
  case "$1" in
    agy)      echo "agy update" ;;
    claude)   echo "claude update" ;;
    devin)    echo "devin update" ;;
    cursor)   echo "cursor-agent update" ;;
    opencode) echo "opencode upgrade" ;;
    gemini)   echo "npm update -g @google/gemini-cli" ;;
    codex)    echo "npm update -g @openai/codex" ;;
    amp)      echo "npm update -g @sourcegraph/amp" ;;
    *) return 1 ;;
  esac
}

# --- which CLIs to update --------------------------------------------------
# 1) If the config file exists, it rules (explicit list, one per line).
# 2) Otherwise auto: the agent kinds herdr supports that are also installed.
pick_clis() {
  if [ -s "$CLIS_FILE" ]; then
    grep -vE '^[[:space:]]*(#|$)' "$CLIS_FILE" | tr -d ' \t'
    return
  fi
  [ -x "$HERDR_BIN" ] || return 0
  "$HERDR_BIN" agent start --help 2>&1 \
    | grep -A3 'possible values' | tr -d '\n' \
    | sed -E 's/.*\[possible values: ([^]]*)\].*/\1/' | tr -d ' ' | tr ',' '\n' \
    | while read -r kind; do
        [ -n "$kind" ] || continue
        command -v "$(exe_for "$kind")" >/dev/null 2>&1 && echo "$kind"
      done
}

# --- run one update with a time cap ----------------------------------------
# Goes through a pty (script -q): several CLIs only update when they believe
# they are in a terminal, and without a pty they exit quietly with rc=0 having
# done nothing. stdin is closed so an unexpected prompt aborts instead of
# hanging your shell.
run_capped() {
  local secs="$1"; shift
  local tmp rc pid watchdog
  tmp="$(mktemp "$STATE_DIR/out.XXXXXX")"

  if command -v script >/dev/null 2>&1; then
    script -q /dev/null "$@" </dev/null >"$tmp" 2>&1 &
  else
    "$@" </dev/null >"$tmp" 2>&1 &
  fi
  pid=$!

  ( sleep "$secs"; kill -TERM "$pid" 2>/dev/null ) >/dev/null 2>&1 &
  watchdog=$!

  wait "$pid"; rc=$?
  kill -TERM "$watchdog" 2>/dev/null; wait "$watchdog" 2>/dev/null

  # script(1) echoes the EOF as "^D" followed by backspaces: strip those too
  tr -d '\r\004\010' <"$tmp" \
    | sed -E 's/\x1b\[[0-9;?]*[a-zA-Z]//g; s/\x1b[=>]//g; s/\^D//g' \
    | grep -v '^[[:space:]]*$' >>"$LOG"
  rm -f "$tmp"
  return "$rc"
}

CLIS="$(pick_clis)"

if [ "$LIST_ONLY" = 1 ]; then
  [ -z "$CLIS" ] && { say "no agent CLI detected"; exit 0; }
  printf '%s\n' "$CLIS"
  exit 0
fi

[ -z "$CLIS" ] && { log "no CLIs detected, nothing to do"; exit 0; }

# --- throttle --------------------------------------------------------------
if [ "$FORCE" = 0 ] && [ "$THROTTLE_HOURS" != 0 ] && [ -f "$STAMP" ]; then
  now=$(date +%s); last=$(cat "$STAMP" 2>/dev/null || echo 0)
  if [ $(( now - last )) -lt $(( THROTTLE_HOURS * 3600 )) ]; then
    log "throttle active, skipping"
    exit 0
  fi
fi

# --- lock: two Ghostty windows at once do not step on each other -----------
if ! mkdir "$LOCK" 2>/dev/null; then
  log "another run in progress, skipping"
  exit 0
fi
trap 'rmdir "$LOCK" 2>/dev/null' EXIT INT TERM

log "=== run: $(printf '%s' "$CLIS" | tr '\n' ' ') ==="
say "  herdr: updating CLIs …"

failed=""; missing=""; norecipe=""
for cli in $CLIS; do
  if ! cmd="$(update_cmd_for "$cli")"; then
    # Loud on purpose: if a new agent shows up, I want to know.
    norecipe="$norecipe $cli"
    log "NO RECIPE: $cli (add it to update_cmd_for)"
    continue
  fi
  bin="${cmd%% *}"
  if ! command -v "$bin" >/dev/null 2>&1; then
    missing="$missing $cli"
    log "SKIP $cli: '$bin' not in PATH"
    continue
  fi
  log "--- $cli: $cmd"
  run_capped "$CLI_TIMEOUT" $cmd; rc=$?
  if [ "$rc" = 0 ]; then
    log "OK $cli"
  else
    failed="$failed $cli"
    [ "$rc" = 143 ] && log "FAIL $cli: killed by ${CLI_TIMEOUT}s timeout" \
                    || log "FAIL $cli (rc=$rc)"
  fi
done

date +%s >"$STAMP"

if [ -n "$failed" ] || [ -n "$missing" ] || [ -n "$norecipe" ]; then
  [ -n "$failed" ]   && say "  herdr: failed ->$failed  (log: $LOG)"
  [ -n "$missing" ]  && say "  herdr: not installed ->$missing"
  [ -n "$norecipe" ] && say "  herdr: no update recipe ->$norecipe"
else
  say "  herdr: CLIs up to date ($(printf '%s' "$CLIS" | tr '\n' ' '))"
fi
log "=== end ==="
