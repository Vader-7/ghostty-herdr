# ══════════════════════════════════════════════════════
#  Ghostty · terminal setup  —  Vesper theme
#  (#101010 black, white text, peach accents.
#   Always dark, does not follow system appearance)
# ══════════════════════════════════════════════════════

theme = Vesper
font-family = JetBrainsMono Nerd Font Mono
font-size = 16
# line height: the air that keeps it from feeling cramped
adjust-cell-height = 12%

# ─── Background ──────────────────────────────────────
# ABSOLUTE path (the zsh hook runs test -f on it, ~ is not expanded).
# Build the -blur twin next to it with make-blur.py.
background-image = /Users/you/Pictures/wallpaper.jpg
background-image-fit = cover
background-image-position = center
background-image-opacity = 0.45
background-opacity = 1.0
# background-blur = 24   # inert while background-opacity is 1.0

# ─── Window ──────────────────────────────────────────
window-padding-x = 48
window-padding-y = 24
window-padding-balance = true
macos-titlebar-style = hidden
# left: left Option = Alt (herdr shortcuts).
# Right Option keeps the dead keys of the ABC layout: Option+n, n -> ñ ; Option+e, a -> á.
macos-option-as-alt = left

# ─── Cursor ──────────────────────────────────────────
cursor-style = block
cursor-style-blink = false

# ─── Behavior ────────────────────────────────────────
mouse-hide-while-typing = true
confirm-close-surface = false
# Only dims Ghostty's own splits (cmd+d), never a herdr pane.
unfocused-split-opacity = 0.85

# ─── Native splits ───────────────────────────────────
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+enter=toggle_split_zoom

# ─── herdr: direct shortcuts (Ghostty sends the prefix ctrl+b = \x02) ───
# Keys by PHYSICAL POSITION (W3C codes: key_h, backquote, bracket_left...).
# Layout independent: ABC, Latin American, whatever, the key does not move.
# All with the LEFT Option, see macos-option-as-alt above.
# Panes
keybind = alt+key_h=text:\x02h
keybind = alt+key_j=text:\x02j
keybind = alt+key_k=text:\x02k
keybind = alt+key_l=text:\x02l
keybind = alt+key_z=text:\x02z
keybind = alt+key_v=text:\x02v
keybind = alt+key_s=text:\x02-
# Last pane: on some 65% keyboards backquote is Fn+Esc, hence the alias on semicolon
keybind = alt+backquote=text:\x02u
keybind = alt+semicolon=text:\x02u
# Jump
keybind = alt+key_g=text:\x02g
keybind = alt+key_b=text:\x02b
# Workspaces
keybind = alt+tab=text:\x02a
keybind = alt+shift+tab=text:\x02A
# Agents
keybind = alt+key_a=text:\x02d
keybind = alt+shift+key_a=text:\x02f
# Tabs
keybind = alt+bracket_right=text:\x02n
keybind = alt+bracket_left=text:\x02p
keybind = alt+key_c=text:\x02c
# Occasional (with shift)
keybind = alt+shift+key_w=text:\x02w
keybind = alt+shift+key_n=text:\x02N
keybind = alt+shift+key_r=text:\x02W
keybind = alt+shift+key_t=text:\x02T
keybind = alt+shift+key_x=text:\x02x
